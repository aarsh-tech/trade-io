{
  "name": "algo-trade",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "node scripts/clean-cache.js",
    "clean:cache": "node scripts/clean-cache.js",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:sqlite:generate": "prisma generate --schema=./prisma/schema.sqlite.prisma",
    "db:sqlite:push": "prisma db push --schema=./prisma/schema.sqlite.prisma",
    "desktop:prep": "node scripts/prep-desktop.js",
    "desktop:build": "pnpm --filter @algo-trade/desktop build:main",
    "desktop:pack": "pnpm desktop:prep && pnpm --filter @algo-trade/desktop run pack",
    "desktop:dist": "pnpm desktop:prep && pnpm --filter @algo-trade/desktop dist",
    "desktop:dist:portable": "pnpm desktop:prep && pnpm --filter @algo-trade/desktop dist:portable"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "prettier": "3.4.2",
    "@types/node": "22.10.7"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "prisma": "6.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}