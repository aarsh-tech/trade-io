# ==============================================================================
# Tradeio.site Production Environment Template (AWS Lightsail)
# ==============================================================================

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/algotrade?schema=public"

# Node Environment
NODE_ENV="production"
PORT=3002

# Allowed Frontend Origins for CORS & WebSockets (comma-separated)
FRONTEND_URL="https://tradeio.site,https://www.tradeio.site"

# Security & Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET="generate-a-strong-random-64-character-hex-secret-here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# AES-256 Encryption Secret for Broker API Keys (32-byte / 64-hex chars)
ENCRYPTION_SECRET="generate-a-strong-random-64-character-hex-secret-here"
# Only during key rotation: comma-separated OLD secrets, used to read old records until scripts/migrate-encryption.js has run. Remove afterwards.
# LEGACY_ENCRYPTION_SECRETS=""

# Swagger Documentation (default: false in production)
ENABLE_SWAGGER="false"

# FYERS (API v3) broker accounts
# Redirect URL saved in the FYERS app; defaults to <first FRONTEND_URL>/brokers/callback
# FYERS_REDIRECT_URI="https://tradeio.site/brokers/callback"
# Live FYERS orders stay blocked (paper trading only) until this is "true"
FYERS_LIVE_ORDERS="false"
