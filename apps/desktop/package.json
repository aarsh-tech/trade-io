{
  "name": "@algo-trade/desktop",
  "version": "1.0.0",
  "description": "TradeIO Desktop Algorithmic Trading Platform",
  "author": "TradeIO",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.tradeio.app",
    "productName": "TradeIO",
    "copyright": "Copyright © 2026 TradeIO",
    "npmRebuild": false,
    "compression": "normal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/.next/standalone",
        "to": "web-server",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/tests/**",
          "!**/test/**"
        ]
      },
      {
        "from": "../auth-service/standalone",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TradeIO.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "TradeIO-Setup.exe"
    }
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "electron": "34.0.0",
    "electron-builder": "25.1.8",
    "typescript": "5.7.3"
  }
}
