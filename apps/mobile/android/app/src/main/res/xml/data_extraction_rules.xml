<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or device-transfer the app's data. The saved session is encrypted
     with a key that lives in this phone's Keystore; restored onto a new install it can't be
     decrypted and breaks sign-in ("Failed to unwrap key"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
